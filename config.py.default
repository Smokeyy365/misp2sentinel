####
# Microsoft section
#
ms_auth = {
    'tenant_id': '<tenant>',
    'client_id': '<client_id>',
    'client_secret': '<client_secret>',
    'scope': 'https://sentinel.azure.com/.default'   # Scope for STIX Objects API
}

# Sentinel STIX Objects API
# Note: The endpoint varies by region. Use the appropriate endpoint for your deployment.
# Regional endpoints:
#   - US: https://sentinelus.azure-api.net
#   - Global: https://api.ti.sentinel.azure.com
# If you were previously using sentinelus.azure-api.net for Upload Indicators API,
# continue using it for STIX Objects API with the updated path.
sentinel_api_endpoint = "https://sentinelus.azure-api.net"
sentinel_workspace_id = "<workspace-id>"

ms_max_indicators_request = 100     # STIX Objects API: Throttle max: 100 indicators per request
ms_max_requests_minute = 100        # STIX Objects API: Throttle max: 100 requests per minute


####
# MISP section
misp_key = '<misp api_key>'
misp_domain = '<misp url>'
misp_verifycert = False

misp_event_filters = {
    "published": 1,
    "tags": [ "workflow:state=\"complete\""],
    #"enforceWarninglist": True,
    "includeEventTags": True,
    "publish_timestamp": "14d",
}

misp_event_limit_per_page = 100     # Upload Indicators API: Limit memory use when querying MISP for STIX packages

####
# Integration settings

ignore_localtags = True             
network_ignore_direction = True     # Graph API only

default_confidence = 50             # Sentinel default confidence level of indicator

# Indicator expiration settings
# By default, MISP's last_seen attribute (converted to valid_until) is used for indicator expiration
# Set days_to_expire_ignore_misp_last_seen = True to override and calculate expiration from config
days_to_expire = 50                 # Days to expire (used when days_to_expire_ignore_misp_last_seen = True or last_seen not set)
days_to_expire_start = "current_date" # Start counting from "valid_from" | "current_date"
days_to_expire_mapping = {          # Custom expiration per indicator type
                    "ipv4-addr": 180,
                    "ipv6-addr": 180,
                    "domain-name": 180,
                    "url": 365,
                }
# days_to_expire_ignore_misp_last_seen = False  # Default: Use MISP's last_seen for expiration

log_file = "/tmp/misp2sentinel.log"
write_post_json = False             # Graph API only
verbose_log = False
write_parsed_indicators = False     # Upload Indicators only
write_parsed_eventid = False

misp_flatten_attributes = True      # Convert all attributes in objects to "atomic" attributes. This can help when attributes are not "mapped" in misp-stix